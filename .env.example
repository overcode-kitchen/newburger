# NewBurger 환경변수 — 이 파일을 .env.local 로 복사해 값을 채웁니다.
# Supabase 대시보드 > Project Settings > API

# 앱 (필수) — 없으면 메뉴 목록이 항상 빈 배열
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 크롤러 (서버 전용 · RLS 우회) — 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 크롤러 User-Agent 에 붙는 연락처 (예: contact@newburger.kr). 브랜드가 수집 관련 연락을 할 수 있는 통로
CRAWLER_CONTACT=

# 브랜드 마크 표시 방식: logo(기본) | initial | text. 브랜드 측 요청 시 이 값 하나로 당일 전환 (docs/legal/brand-mark-policy.md)
NEXT_PUBLIC_BRAND_MARK=logo

# 소개 페이지에 노출되는 문의 이메일. 비우면 "이메일(준비 중)"으로 표시
NEXT_PUBLIC_CONTACT_EMAIL=
